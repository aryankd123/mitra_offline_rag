# Machine-specific settings read by config.py (design R12). Set them in your shell; this file is not loaded automatically.
# PowerShell:  $env:MITRA_GENERATOR_MODEL = "gemma3:4b"
# bash:        export MITRA_GENERATOR_MODEL=gemma3:4b

MITRA_GENERATOR_MODEL=gemma3:1b   # gemma3:4b on a machine with a GPU or plenty of RAM
MITRA_DATA_DIR=./data             # holds raw/, chroma/, embed_cache.sqlite
MITRA_API_HOST=127.0.0.1          # keep localhost; use an SSH tunnel to reach a remote machine
MITRA_API_PORT=8000
MITRA_OFFLINE_GUARD=1             # 1 = block non-loopback network access from the API process
OLLAMA_HOST=http://127.0.0.1:11434  # read by the ollama client, not by config.py
